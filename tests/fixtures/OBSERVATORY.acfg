*** definition of variables:

**********************************************
**************** obs to tel ******************
**********************************************

STRING_VAR	obs_source_name		%64s
obs_source_name
UNKNOWN
! source name (for display and archiving); leading @/#: tokens for non-siderial object (tel_supports_ephemeris=N: kephem: @->#, # triggers telescope; =Y: kephem inactive, @ triggers telescope, name must match non-sidereal position)
OBS2TEL_FILE |  OBS2TEL_WRITE | READ_OBSDOP OBS2TEL_READ K_SET_OBSERVATORY \anchor source_name__obs2tel
/* HouseKeepingDataBase */

INT_VAR		obs_scan_num		%12d
obs_scan_num
0
! scan number (for display and archiving)
OBS2TEL_FILE | OBS2TEL_WRITE | OBS2TEL_READ K_SET_OBSERVATORY \anchor obs_scan_num__obs2tel
/* HouseKeepingDataBase */

INT_VAR		obs_sub_scan_num	%12d
obs_sub_scan_num
0
! subscan number (for display and archiving)
OBS2TEL_FILE | OBS2TEL_WRITE | OBS2TEL_READ K_SET_OBSERVATORY \anchor obs_sub_scan_num__obs2tel
/* HouseKeepingDataBase */

DOUBLE_VAR	obs_tel_info_update_time	%12.8g
obs_tel_info_update_time
0.0
! cycle time for updating feedback-file [seconds],  =0.: no continuous update
OBS2TEL_FILE | OBS2TEL_WRITE | OBS2TEL_READ K_SET_OBSERVATORY \anchor obs_tel_info_update_time__obs2tel
/* HouseKeepingDataBase */

INT_VAR		obs_cookie		%12d
obs_cookie
0
! unique internal identifier for observation
OBS2TEL_FILE | OBS2TEL_WRITE | READ_OBSDOP kephem OBS2TEL_READ K_SET_OBSERVATORY \anchor obs_cookie__obs2tel
OBS2SOFIA_FILE | OBS2SOFIA_WRITE | OBS2SOFIA_READ \anchor obs_cookie__obs2sofia 
/* HouseKeepingDataBase */

#if defined (OBS_SOFIA)
**************************
*** chop signal stuff ****
**************************

STRING_VAR obs_chop_signal_source %s
obs_chop_signal_source
TELESCOPE
! chopper TTL-signal source 
KOSMA_obs2chpsignal.set | OBS2CHOP_WRITE | OBS2CHPSIGNAL_READ control_skychop load_server \anchor obs_chop_signal_source__obs2chpsignal
/* HouseKeepingDataBase */

INT_VAR		obs_chop_signal_cookie		%12d
obs_chop_signal_cookie
0
! unique internal identifier for observation (to chopper signal)
KOSMA_obs2chpsignal.set | OBS2CHOP_WRITE | control_skychop OBS2CHPSIGNAL_READ \anchor obs_chop_signal_cookie__obs2chpsignal
/* HouseKeepingDataBase */

#if defined (INSTR_GREAT) || defined (INSTR_UPGREAT)
STRING_VAR	obs_loadchop_active		%1s
obs_loadchop_active
Nc	
! switch load chopper on or off [Y/N]
KOSMA_obs2chpsignal.set | OBS2CHOP_WRITE | control_skychop OBS2CHPSIGNAL_READ \anchor obs_loadchop_active__obs2chpsignal
/* HouseKeepingDataBase */
#endif

STRING_VAR chop_signal_ok %s
chop_signal_ok
N
! chopper signal source settings are acknowledged: OK
KOSMA_chpsignal2obs.set | CHPSIGNAL2OBS_WRITE | control_skychop \anchor chop_signal_ok__chpsignal2obs
/* HouseKeepingDataBase */

INT_VAR chop_signal_cookie %d
chop_signal_cookie
0
! cookie for chopper signal source settings to chopper box
KOSMA_chpsignal2obs.set | CHPSIGNAL2OBS_WRITE | control_skychop \anchor chop_signal_cookie__chpsignal2obs
/* HouseKeepingDataBase */
#endif

**********************************************
********** telescope positioning *************
**********************************************

STRING_VAR	obs_coord_sys_on	%32s
obs_coord_sys_on
J2000
! coordinate system of source position (eg. J2000, B1950, GALACTIC, HORIZON)
OBS2TEL_FILE | OBS2TEL_WRITE | OBS2TEL_READ K_SET_OBSERVATORY \anchor obs_coord_sys_on__obs2tel
/* HouseKeepingDataBase */

DOUBLE_VAR	obs_lam_on		%12.8g
obs_lam_on
0.0
! first coordinate axis of spherical coordinate system obs_coord_sys_on [degree]
OBS2TEL_FILE | OBS2TEL_WRITE | OBS2TEL_READ K_SET_OBSERVATORY \anchor obs_lam_on__obs2tel
/* HouseKeepingDataBase */

DOUBLE_VAR	obs_bet_on		%12.8g
obs_bet_on
0.0
! second coordinate axis of spherical coordinate system obs_coord_sys_on [degree]
OBS2TEL_FILE | OBS2TEL_WRITE | OBS2TEL_READ K_SET_OBSERVATORY \anchor obs_bet_on__obs2tel
/* HouseKeepingDataBase */

#if defined (OBS_CCAT)
DOUBLE_VAR	obs_pm_lam		%12.8g
obs_pm_lam
0.0
! lam proper motion [arcsec/yr]
OBS2TEL_FILE | OBS2TEL_WRITE | OBS2TEL_READ K_SET_OBSERVATORY \anchor obs_pm_lam__obs2tel
/* HouseKeepingDataBase */

DOUBLE_VAR	obs_pm_bet		%12.8g
obs_pm_bet
0.0
! bet proper motion [arcsec/yr]
OBS2TEL_FILE | OBS2TEL_WRITE | OBS2TEL_READ K_SET_OBSERVATORY \anchor obs_pm_bet__obs2tel
/* HouseKeepingDataBase */

DOUBLE_VAR	obs_paralx		%12.8g
obs_paralx
0.0
! parallax of astronomical object [arcsec]
OBS2TEL_FILE | OBS2TEL_WRITE | OBS2TEL_READ K_SET_OBSERVATORY \anchor obs_pm_bet__obs2tel
/* HouseKeepingDataBase */

STRING_VAR      obs_extended_elevation_range  %1s
obs_extended_elevation_range
